# Copie para .env e ajuste. Em desenvolvimento, nenhuma variável é obrigatória (há padrões locais).
# Em produção, rode o backend com SPRING_PROFILES_ACTIVE=prod: a aplicação NÃO sobe se faltar
# JWT_SECRET, CORS_ALLOWED_ORIGINS ou as variáveis de banco.

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# Banco de dados (MySQL 8)
DB_HOST=db.exemplo.com
DB_PORT=3306
DB_NAME=agrogestao
DB_USER=agrogestao
DB_PASSWORD=troque-esta-senha
DB_USE_SSL=true

# Autenticação — gere com: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MINUTES=480

# Painel de administração da plataforma (/admin): e-mails com acesso, separados por vírgula.
# Em produção não há padrão (ninguém é admin até definir). O acesso só vale depois que o
# e-mail da conta for confirmado pelo link enviado no cadastro.
PLATFORM_ADMIN_EMAILS=

# Envio de e-mails (confirmação de e-mail e recuperação de senha) — SMTP com STARTTLS
MAIL_HOST=smtp.exemplo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=AgroGestão <nao-responda@exemplo.com>
# Endereço público do frontend, usado nos links dos e-mails
APP_BASE_URL=https://app.exemplo.com

# Limite de e-mails de convite para a equipe, por propriedade, a cada 24h
INVITATIONS_MAX_PER_PROPERTY_PER_DAY=20

# Domínio(s) do frontend, separados por vírgula
CORS_ALLOWED_ORIGINS=https://app.exemplo.com
